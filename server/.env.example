# =====================================================================
#  EventEase - Example environment file  (SAFE to share - no real secrets)
#  Copy this to ".env" and fill in the real values.
# =====================================================================

# ----- DEVELOPMENT: local Prisma Postgres -----
# Dev data must never touch Supabase, so development runs against a local
# Postgres started with:  npx prisma dev   (leave it running)
# That command prints the URL to paste here.
DATABASE_URL="prisma+postgres://localhost:<port>/?api_key=<key>"
DIRECT_URL="prisma+postgres://localhost:<port>/?api_key=<key>"

# ----- SUBMISSION: Supabase PostgreSQL -----
# Only switch to these for the final demo, then run the seed.
# Transaction-mode pooler (normal app queries):
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?pgbouncer=true"
# Session-mode pooler (used for Prisma migrations):
#   DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres"
# NOTE: if the password contains "@" or a space, percent-encode them
# (@ becomes %40, space becomes %20) or the URL silently fails to connect.

# Secret key used to sign JWT login tokens
JWT_SECRET="<a-long-random-string>"
JWT_EXPIRES_IN="7d"

PORT=5000
